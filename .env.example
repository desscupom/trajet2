# Copie este arquivo para .env e preencha com suas chaves reais
# NUNCA suba o .env com as chaves reais para o GitHub

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Pexels (fotos para capas e stories)
EXPO_PUBLIC_PEXELS_API_KEY=sua_pexels_key_aqui

# OpenAI (assistente IA)
EXPO_PUBLIC_OPENAI_API_KEY=sua_openai_key_aqui

# Edge functions (opcional)
EXPO_PUBLIC_USE_EDGE_FUNCTION=false
